{
  "name": "idos-sdk-js",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "pnpm --filter './packages/**' build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev",
    "postinstall": "lefthook install",
    "preinstall": "npx only-allow pnpm",
    "size": "size-limit",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "ci:publish": "pnpm publish -r",
    "publint": "pnpm --filter './packages/**' run publint"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@size-limit/esbuild": "^11.2.0",
    "@size-limit/file": "^11.2.0",
    "audit-ci": "^7.1.0",
    "lefthook": "1.13.6",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.85.0",
    "size-limit": "^11.2.0",
    "turbo": "^2.10.8",
    "vite-plugin-node-polyfills": "catalog:build"
  },
  "packageManager": "pnpm@11.26.0"
}

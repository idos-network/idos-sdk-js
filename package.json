{
  "name": "idos-sdk-js",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "pnpm --filter './packages/**' build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev",
    "postinstall": "lefthook install",
    "preinstall": "npx only-allow pnpm",
    "size": "size-limit",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "ci:publish": "pnpm publish -r",
    "publint": "pnpm --filter './packages/**' run publint"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@size-limit/file": "^13.0.0",
    "@size-limit/time": "^13.0.0",
    "audit-ci": "^7.1.0",
    "lefthook": "2.1.12",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "size-limit": "^13.0.0",
    "turbo": "^2.10.8",
    "vite-plugin-node-polyfills": "catalog:build"
  },
  "size-limit": [
    {
      "name": "@idos-network/client",
      "path": "packages/client/dist/index.js",
      "limit": "2.0 MB"
    },
    {
      "name": "@idos-network/consumer",
      "path": "packages/consumer/dist/index.mjs",
      "limit": "500 KB"
    },
    {
      "name": "@idos-network/issuer",
      "path": "packages/issuer/dist/index.mjs",
      "limit": "550 KB",
      "running": false
    },
    {
      "name": "@idos-network/credentials",
      "path": "packages/credentials/dist/**/*.mjs",
      "limit": "20 KB"
    },
    {
      "name": "@idos-network/enclave",
      "path": "packages/enclave/dist/**/*.mjs",
      "limit": "20 KB"
    },
    {
      "name": "@idos-network/kwil-infra",
      "path": "packages/kwil-infra/dist/**/*.mjs",
      "limit": "20 KB"
    },
    {
      "name": "@idos-network/utils",
      "path": "packages/utils/dist/**/*.mjs",
      "limit": "20 KB"
    }
  ],
  "packageManager": "pnpm@12.3.4"
}

# Copy to .env and fill in before running `pnpm test:integration`.

# ETH / secp256k1 private key the tests sign with
PRIVATE_KEY=
# JSON-RPC endpoint of the Kwil node under test, e.g. http://localhost:8484
KWIL_PROVIDER=
CHAIN_ID=
# Ethereum RPC, only needed by the funder tests
ETH_PROVIDER=

# Feature switches - these select which suites actually run
GATEWAY_ON=FALSE
GAS_ON=FALSE
PRIVATE_MODE=FALSE

{
  "name": "@idos-network/kwil-js",
  "version": "0.2.0",
  "description": "Kwil database client for the idOS JavaScript SDK",
  "homepage": "https://idos.network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idos-network/idos-sdk-js.git",
    "directory": "packages/kwil-js"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/api_client/config.d.mts",
      "import": "./dist/api_client/config.mjs"
    },
    "./action": {
      "types": "./dist/core/action.d.mts",
      "import": "./dist/core/action.mjs"
    },
    "./database": {
      "types": "./dist/core/database.d.mts",
      "import": "./dist/core/database.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "publint": "pnpx publint --strict",
    "test": "vitest",
    "test:integration": "pnpm run build && vitest run --config integration/vitest.config.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && (test -f dist/index.d.mts || pnpm run build) && tsc -p integration/tsconfig.json"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "axios": "^1.19.0",
    "lru-cache": "11.5.2"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "@vitest/coverage-v8": "catalog:testing",
    "dotenv": "^16.4.5",
    "ethers": "catalog:ethereum",
    "scrypt-js": "^3.0.1",
    "tsdown": "catalog:build",
    "tweetnacl": "catalog:core",
    "typescript": "catalog:build",
    "uuid": "^11.1.0",
    "vitest": "catalog:testing"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

{
  "name": "@idos-network/credentials",
  "version": "1.4.0",
  "description": "idOS Credentials JavaScript SDK",
  "homepage": "https://idos.network",
  "license": "MIT",
  "repository": "github:idos-network/idos-sdk-js",
  "files": [
    "assets/**/*",
    "dist/**/*",
    "src/**/*",
    "types/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs"
    },
    "./verifier": {
      "types": "./dist/verifier/index.d.mts",
      "import": "./dist/verifier/index.mjs"
    },
    "./parser": {
      "types": "./dist/parser/index.d.mts",
      "import": "./dist/parser/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "import": "./dist/types/index.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.mts",
      "import": "./dist/schemas/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown  --watch",
    "generate:schemas": "pnpm build && node ./cli/generate-schemas.mjs",
    "publint": "pnpx publint --strict",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@digitalbazaar/ed25519-signature-2020": "catalog:core",
    "@digitalbazaar/ed25519-verification-key-2020": "catalog:core",
    "@digitalbazaar/vc": "catalog:core",
    "@idos-network/utils": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "es-toolkit": "catalog:utils",
    "jsonld-document-loader": "catalog:core",
    "reflect-metadata": "^0.2.2",
    "tiny-invariant": "catalog:core",
    "tweetnacl": "catalog:core",
    "zod": "catalog:core"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "@vitest/coverage-v8": "catalog:testing",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:testing",
    "web-streams-polyfill": "3.3.3"
  },
  "peerDependencies": {
    "typescript": "catalog:build"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
